# ============================================================
# 本地密钥配置模板
#
# 用法：复制本文件为 .env，填入真实值。
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入版本库。
# 构建时通过 scripts/build_local.ps1 自动转成 --dart-define 注入。
#
# ⚠️ 安全须知：dart-define 的值会被编译进 APK/IPA，
#    可被逆向提取。它解决的是「不泄露到 git 仓库 / 不被搜索引擎索引」，
#    不等于加密。真正的秘密必须留在服务端。
# ============================================================

# ---- AI 能力（App 内 agent 模块）----
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ---- 115 网盘（「癫影 115」资源转存）----
# 格式：UID=xxx; CID=xxx; SEID=xxx; KID=xxx
# 留空则 App 内不预置，用户需在「癫影 115」设置面板自行填写并保存在本机。
# 强烈建议留空——共享账号 Cookie 一旦随产物分发即等同于公开。
PAN115_COOKIE=

# ---- GitHub Actions 状态查询 ----
# 建议使用 fine-grained PAT，仅授予：
#   Actions: Read-only + Contents: Read-only
# 绝不要使用 repo 全权限的 classic token（ghp_ 开头）。
# 留空则走 GitHub 匿名调用（60 次/小时/IP），对本 App 场景足够。
GITHUB_ACTIONS_TOKEN=
